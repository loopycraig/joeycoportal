{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "portal-no-clarify",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLARIFY_API_KEY=",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}
